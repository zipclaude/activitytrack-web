  "behaviours": [
    {
      "key": "askTravelDone",
      "kind": "BOOLEAN",
      "default": true,
      "doc": "true — false: a running travel is closed when another activity starts, without asking"
    },
    {
      "key": "closeCompleteOnStop",
      "kind": "BOOLEAN",
      "default": true,
      "doc": "true — false: Stop always leaves the activity \"to complete\""
    },
    {
      "key": "minDurationSec",
      "kind": "INT",
      "default": 60,
      "doc": "60 — shorter activities, travels and segments are an error (0 = no limit)"
    },
    {
      "key": "exportMaxDays",
      "kind": "INT",
      "default": 366,
      "doc": "366 — longest export period in days"
    }
