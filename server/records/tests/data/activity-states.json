{
	"about": "Displayed state of an activity (docs/ACTIVITY-MODEL.md, 2.2-2.4). Every implementation runs these cases. Times are local to `zone`; a plan is {day, startMin?, durationMin?}; a due date is {day, timeMin?}; `missingRequired` = a field the company's plugin requires is empty.",
	"zone": "Europe/Rome",
	"now": "2026-11-11T10:00:00+01:00",
	"cases": [
		{"name": "todo, nothing set", "activity": {"kind": "ACTIVITY", "status": "TODO"}, "segments": [], "expect": {"state": "TODO", "since": null}},
		{"name": "todo, whole-day plan tomorrow", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-12"}}, "segments": [], "expect": {"state": "PLANNED", "since": "2026-11-12T00:00:00+01:00"}},
		{"name": "todo, whole-day plan today is not late", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-11"}}, "segments": [], "expect": {"state": "PLANNED", "since": "2026-11-11T00:00:00+01:00"}},
		{"name": "todo, whole-day plan yesterday", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-10"}}, "segments": [], "expect": {"state": "LATE", "since": "2026-11-10T00:00:00+01:00"}},
		{"name": "todo, block 08:00-09:00 today is over", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-11", "startMin": 480, "durationMin": 60}}, "segments": [], "expect": {"state": "LATE", "since": "2026-11-11T08:00:00+01:00"}},
		{"name": "todo, block 09:30-10:30 today is running, not late", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-11", "startMin": 570, "durationMin": 60}}, "segments": [], "expect": {"state": "PLANNED", "since": "2026-11-11T09:30:00+01:00"}},
		{"name": "todo, point in time 09:30 has passed", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-11", "startMin": 570}}, "segments": [], "expect": {"state": "LATE", "since": "2026-11-11T09:30:00+01:00"}},
		{"name": "todo, due today without time", "activity": {"kind": "ACTIVITY", "status": "TODO", "due": {"day": "2026-11-11"}}, "segments": [], "expect": {"state": "PLANNED", "since": null}},
		{"name": "todo, due today at 09:00", "activity": {"kind": "ACTIVITY", "status": "TODO", "due": {"day": "2026-11-11", "timeMin": 540}}, "segments": [], "expect": {"state": "LATE", "since": null}},
		{"name": "todo, planned segment this afternoon", "activity": {"kind": "ACTIVITY", "status": "TODO"}, "segments": [{"kind": "WORK", "start": "2026-11-11T14:00:00+01:00", "end": "2026-11-11T16:00:00+01:00", "planned": true}], "expect": {"state": "PLANNED", "since": "2026-11-11T14:00:00+01:00"}},
		{"name": "todo, planned segment yesterday", "activity": {"kind": "ACTIVITY", "status": "TODO"}, "segments": [{"kind": "WORK", "start": "2026-11-10T14:00:00+01:00", "end": "2026-11-10T16:00:00+01:00", "planned": true}], "expect": {"state": "LATE", "since": "2026-11-10T14:00:00+01:00"}},
		{"name": "todo, planned segments: the last one has not ended", "activity": {"kind": "ACTIVITY", "status": "TODO", "plan": {"day": "2026-11-10"}}, "segments": [{"kind": "WORK", "start": "2026-11-10T14:00:00+01:00", "end": "2026-11-10T16:00:00+01:00", "planned": true}, {"kind": "WORK", "start": "2026-11-12T09:00:00+01:00", "end": "2026-11-12T12:00:00+01:00", "planned": true}], "expect": {"state": "PLANNED", "since": "2026-11-10T00:00:00+01:00"}},
		{"name": "todo, planned segment tomorrow but due yesterday", "activity": {"kind": "ACTIVITY", "status": "TODO", "due": {"day": "2026-11-10"}}, "segments": [{"kind": "WORK", "start": "2026-11-12T09:00:00+01:00", "end": "2026-11-12T12:00:00+01:00", "planned": true}], "expect": {"state": "LATE", "since": "2026-11-12T09:00:00+01:00"}},
		{"name": "running, work open", "activity": {"kind": "ACTIVITY", "status": "RUNNING", "client": true}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": null}], "expect": {"state": "WORK", "since": "2026-11-11T08:00:00+01:00"}},
		{"name": "running, travel open after work", "activity": {"kind": "ACTIVITY", "status": "RUNNING", "client": true}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:00:00+01:00"}, {"kind": "TRAVEL", "start": "2026-11-11T09:00:00+01:00", "end": null}], "expect": {"state": "TRAVEL", "since": "2026-11-11T09:00:00+01:00"}},
		{"name": "running, pause open", "activity": {"kind": "ACTIVITY", "status": "RUNNING", "client": true}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:40:00+01:00"}, {"kind": "PAUSE", "start": "2026-11-11T09:40:00+01:00", "end": null}], "expect": {"state": "PAUSE", "since": "2026-11-11T09:40:00+01:00"}},
		{"name": "running, nothing open", "activity": {"kind": "ACTIVITY", "status": "RUNNING", "client": true}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:30:00+01:00"}], "expect": {"state": "SUSPENDED", "since": "2026-11-11T09:30:00+01:00"}},
		{"name": "closed, client and work", "activity": {"kind": "ACTIVITY", "status": "CLOSED", "client": true, "closedAt": "2026-11-11T09:46:00+01:00"}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:45:00+01:00"}], "expect": {"state": "DONE", "since": "2026-11-11T09:45:00+01:00"}},
		{"name": "closed, no client", "activity": {"kind": "ACTIVITY", "status": "CLOSED", "client": false}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:45:00+01:00"}], "expect": {"state": "INCOMPLETE", "since": "2026-11-11T09:45:00+01:00"}},
		{"name": "closed, travel only", "activity": {"kind": "ACTIVITY", "status": "CLOSED", "client": true}, "segments": [{"kind": "TRAVEL", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:00:00+01:00"}], "expect": {"state": "INCOMPLETE", "since": "2026-11-11T09:00:00+01:00"}},
		{"name": "closed, a required plugin field is empty", "activity": {"kind": "ACTIVITY", "status": "CLOSED", "client": true}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:45:00+01:00"}], "missingRequired": true, "expect": {"state": "INCOMPLETE", "since": "2026-11-11T09:45:00+01:00"}},
		{"name": "closed, a task ticked off without segments", "activity": {"kind": "ACTIVITY", "status": "CLOSED", "client": false, "closedAt": "2026-11-11T09:00:00+01:00"}, "segments": [], "expect": {"state": "DONE", "since": "2026-11-11T09:00:00+01:00"}},
		{"name": "closed with the end 10 minutes ahead", "activity": {"kind": "ACTIVITY", "status": "CLOSED", "client": true, "closedAt": "2026-11-11T09:59:00+01:00"}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T10:10:00+01:00"}], "expect": {"state": "DONE", "since": "2026-11-11T10:10:00+01:00"}},
		{"name": "absence over two days", "activity": {"kind": "ABSENCE", "status": "CLOSED", "absenceKind": "HOLIDAY"}, "segments": [{"kind": "ABSENCE", "start": "2026-11-12T08:30:00+01:00", "end": "2026-11-12T17:30:00+01:00"}, {"kind": "ABSENCE", "start": "2026-11-13T08:30:00+01:00", "end": "2026-11-13T17:30:00+01:00"}], "expect": {"state": "ABSENCE", "since": "2026-11-12T08:30:00+01:00"}},
		{"name": "deleted todo", "activity": {"kind": "ACTIVITY", "status": "TODO", "deletedAt": "2026-11-09T12:00:00+01:00", "due": {"day": "2026-11-01"}}, "segments": [], "expect": {"state": "DELETED", "since": "2026-11-09T12:00:00+01:00"}},
		{"name": "deleted running activity stays deleted", "activity": {"kind": "ACTIVITY", "status": "RUNNING", "deletedAt": "2026-11-11T09:00:00+01:00"}, "segments": [{"kind": "WORK", "start": "2026-11-11T08:00:00+01:00", "end": "2026-11-11T09:00:00+01:00"}], "expect": {"state": "DELETED", "since": "2026-11-11T09:00:00+01:00"}}
	]
}
