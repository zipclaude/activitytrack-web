; /etc/activitytrack-web/settings.ini (docs/INSTALL.md)

[server]
; public address of the server, written in the pairing QR codes; with a
; path (https://www.example.com/activitytrack) the application lives there
base_url = https://at.example.com
allowed_hosts = at.example.com
; database (SQLite), attachments, secret key
data_dir = /var/lib/activitytrack-web
static_root = /var/lib/activitytrack-web/static
time_zone = Europe/Rome
; sha256 of the server's public key, only for a certificate the phones do not
; trust (self-signed); see docs/INSTALL.md
;tls_pin =
;debug = false

[database]
; sqlite (default) or postgresql
engine = sqlite
; for postgresql: empty host = Unix socket with peer authentication
;engine = postgresql
;name = activitytrack
;user = activitytrack-web

[files]
max_mb = 25
; who sends the attachments: none (Django), nginx (X-Accel-Redirect to the
; internal location below) or apache (X-Sendfile, needs libapache2-mod-xsendfile)
offload = none
;offload = nginx
;accel_location = /_files/

[maps]
; offline maps for the phones' track map (docs/OFFLINE-MAPS.md): where the basemap
; is read from, by byte ranges: "latest" (the newest daily build of Protomaps,
; https://build.protomaps.com/), the URL of a PMTiles archive, or a file
;source = latest
; the highest zoom (12: about 1:100 000), the largest radius and the largest map an admin may ask for
;max_zoom = 12
;max_radius_km = 250
;max_mb = 48

[mail]
; for the login codes by email (two-step verification); without a host the
; codes come only from an authenticator app
;host = smtp.example.com
;port = 587
; starttls (port 587), ssl (port 465) or none
;security = starttls
;user = activitytrack@example.com
;password =
;from = ActivityTrack <activitytrack@example.com>
